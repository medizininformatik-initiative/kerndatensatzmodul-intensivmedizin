  "name": "MII_PR_ICU_Kontraindikationsbeurteilung",
  "title": "MII PR ICU Kontraindikationsbeurteilung",
  "status": "draft",
  "experimental": true,
  "publisher": "Medizininformatik Initiative",
  "contact": [
    {
      "telecom": [
        {
          "system": "url",
          "value": "https://www.medizininformatik-initiative.de"
